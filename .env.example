# Copia a .env
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgres://coperoco:cambia-esto@localhost:5432/coperoco
PORT=3000
# Cifra las claves de API que los grupos de FavoresCo guardan en la base de datos.
# Genérala con: openssl rand -hex 32   (¡guárdala! si la pierdes, las claves guardadas no se pueden recuperar)
# En desarrollo no hace falta (se usa una clave fija de pruebas); en producción es obligatoria para usar la IA.
SECRETS_KEY=
# Solo producción: dominio para HTTPS automático con Caddy
DOMAIN=coperoco.example.com
