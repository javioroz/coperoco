{
  "name": "coperoco",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @coperoco/api",
    "dev:web": "npm run dev -w @coperoco/web",
    "build": "npm run build -w @coperoco/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d db"
  },
  "devDependencies": {
    "npm-run-all2": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
